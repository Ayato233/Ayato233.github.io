---

<div id="cat-widget" class="fixed bottom-20 right-20 z-[9999] flex flex-col items-center select-none" draggable="false">
	<div class="relative">
		<div class="absolute -left-12 top-1/2 z-20 flex -translate-y-1/2 flex-col gap-2">
			<button
				class="flex h-10 w-10 items-center justify-center rounded-full border border-gray-100 bg-white/90 p-2.5 text-blue-500 shadow-md backdrop-blur-sm transition-transform hover:scale-110 active:scale-95 dark:border-slate-600 dark:bg-slate-700/90 dark:hover:text-blue-600"
				title="聊天"
			>
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5">
					<path fill-rule="evenodd" d="M4.804 21.644A6.7 6.7 0 0 0 6 21.75a6.72 6.72 0 0 0 3.583-1.029c.774.182 1.584.279 2.417.279 5.322 0 9.75-3.97 9.75-9s-4.428-9-9.75-9-9.75 3.97-9.75 9c0 2.409 1.025 4.587 2.674 6.192.232.226.277.428.254.543a3.73 3.73 0 0 1-.814 1.686.75.75 0 0 0 .44 1.223ZM8.25 10.875a1.125 1.125 0 1 0 0 2.25 1.125 1.125 0 0 0 0-2.25ZM10.875 12a1.125 1.125 0 1 1 2.25 0 1.125 1.125 0 0 1-2.25 0Zm4.875-1.125a1.125 1.125 0 1 0 0 2.25 1.125 1.125 0 0 0 0-2.25Z" clip-rule="evenodd"></path>
				</svg>
			</button>
			<button
				class="flex h-10 w-10 items-center justify-center rounded-full border border-gray-100 bg-white/90 shadow-md backdrop-blur-sm transition-transform hover:scale-110 active:scale-95 dark:border-slate-600 dark:bg-slate-700/90"
				title="喂小鱼干"
			>
				<span class="text-xl leading-none">🐟</span>
			</button>
		</div>
		<div class="relative h-28 w-28 cursor-pointer">
			<div class="cat-sprite cat-idle"></div>
		</div>
	</div>
</div>

<style is:global>
	.cat-sprite {
		width: 100%;
		height: 100%;
		background-image: url('/siamese-cat.png');
		background-size: 300% 300%;
		background-repeat: no-repeat;
		image-rendering: pixelated;
		background-position: 0% 0%;
	}
	.cat-idle {
		animation: idle-frames 1.2s infinite;
	}
	@keyframes idle-frames {
		0% { background-position: 0% 0%; }
		33.3% { background-position: 50% 0%; }
		66.6% { background-position: 100% 0%; }
		100% { background-position: 0% 0%; }
	}
</style>

<script>
	// 简单可拖动
	const widget = document.getElementById('cat-widget');
	let dragging = false, ox = 0, oy = 0;
	widget.addEventListener('pointerdown', (e) => {
		if (e.target.closest('button')) return;
		dragging = true;
		ox = e.clientX - widget.offsetLeft;
		oy = e.clientY - widget.offsetTop;
		widget.setPointerCapture(e.pointerId);
	});
	widget.addEventListener('pointermove', (e) => {
		if (!dragging) return;
		widget.style.left = e.clientX - ox + 'px';
		widget.style.top = e.clientY - oy + 'px';
		widget.style.right = 'auto';
		widget.style.bottom = 'auto';
	});
	widget.addEventListener('pointerup', () => (dragging = false));
</script>