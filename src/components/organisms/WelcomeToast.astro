---
/**
 * 首次访问欢迎提示（右下角轻提示）。
 *
 * 设计目标（沿主题「按需加载 / 零额外负担」铁律）：
 * - 会话内只出现一次（sessionStorage 标记，同一标签页不重复打扰）；
 * - 零网络请求：问候文案复用 timeGreetingConfig（本地分时），不接第三方定位/天气接口；
 * - 不打扰阅读：延迟出现、可手动关闭、数秒自动消失、不抢占焦点、aria-live=polite；
 * - 移动端避开底部悬浮导航；reduced-motion 只保留淡入；
 * - SSR 骨架默认不可见（CSS opacity 0 + pointer-events none），禁 JS 时零观感。
 */
import { siteConfig } from "@/config";
import { timeGreetingConfig } from "@/config/timeGreetingConfig";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";

const greetings = timeGreetingConfig.greetings;
const siteName = siteConfig.title;
const welcomeKickerText = i18n(I18nKey.welcomeKicker);
const welcomeTitleText = i18n(I18nKey.welcomeTitle).replace("{site}", siteName);
const closeLabel = i18n(I18nKey.close);
---

<div class="welcome-toast" data-state="idle" role="status" aria-live="polite" aria-atomic="true">
	<span class="welcome-toast__icon" aria-hidden="true">✦</span>
	<div class="welcome-toast__body">
		<span class="welcome-toast__kicker">{welcomeKickerText}</span>
		<strong class="welcome-toast__title">{welcomeTitleText}</strong>
		<p class="welcome-toast__message"></p>
	</div>
	<button class="welcome-toast__close" type="button" aria-label={closeLabel} title={closeLabel}>
		×
	</button>
</div>

<style lang="stylus">
.welcome-toast
	position: fixed
	right: 1.5rem
	bottom: 1.5rem
	z-index: 80
	display: flex
	align-items: flex-start
	gap: 0.75rem
	max-width: 20rem
	padding: 0.875rem 1rem
	border-radius: var(--shape-corner-l)
	background: var(--surface-container)
	color: var(--on-surface)
	box-shadow: 0 8px 28px rgb(0 0 0 / 0.18)
	opacity: 0
	pointer-events: none
	transform: translateY(calc(100% + 1.5rem)) scale(0.96)
	transition:
		opacity var(--m3e-duration-short) ease,
		transform 420ms cubic-bezier(0.22, 1, 0.36, 1)

	&[data-state="visible"]
		opacity: 1
		pointer-events: auto
		transform: translateY(0) scale(1)

	&__icon
		color: var(--primary)
		font-size: 0.875rem
		line-height: 1.4
		margin-top: 0.125rem

	&__body
		display: flex
		flex-direction: column
		gap: 0.125rem
		min-width: 0

	&__kicker
		font-size: 0.6875rem
		font-weight: 700
		letter-spacing: 0.12em
		color: var(--primary)
		opacity: 0.9

	&__title
		font-size: 0.9375rem
		font-weight: 700

	&__message
		margin: 0
		font-size: 0.8125rem
		color: var(--on-surface-variant)

	&__close
		flex: none
		width: 1.5rem
		height: 1.5rem
		display: grid
		place-items: center
		border: none
		border-radius: 999px
		background: transparent
		color: var(--on-surface-variant)
		font-size: 1rem
		line-height: 1
		cursor: pointer
		transition: background var(--m3e-duration-short) ease

		&:hover
			background: var(--surface-container-high)

	@media (max-width: 640px)
		right: 1rem
		left: 1rem
		bottom: calc(4.5rem + env(safe-area-inset-bottom))
		max-width: none

	@media (prefers-reduced-motion: reduce)
		transition:
			opacity var(--m3e-duration-short) ease

		&
			transform: translateY(0) scale(1)
</style>

<script is:inline define:vars={{ greetings, welcomeKickerText, welcomeTitleText }}>
	// 会话内只出现一次：无标记才显示，并立即写入标记
	// （is:inline 为普通内联脚本，逻辑包进 IIFE 避免顶层 return）
	(function () {
		const STORAGE_KEY = "shirone_welcome_seen_v1";
		if (sessionStorage.getItem(STORAGE_KEY)) return;
		sessionStorage.setItem(STORAGE_KEY, "true");

	const root = document.querySelector(".welcome-toast");
	if (!root) return;

	// 填充分时问候（本地时间，零网络）
	const hour = new Date().getHours();
	const msg =
		(greetings || []).filter((g) => g.hour <= hour).at(-1)?.message || "";
	const msgEl = root.querySelector(".welcome-toast__message");
	if (msgEl && msg) msgEl.textContent = msg;

	let shown = false;
	function show() {
		if (shown) return;
		shown = true;
		root.dataset.state = "visible";
	}
	function hide() {
		root.dataset.state = "idle";
	}

	// 延迟出现；可手动关闭；停留几秒后自动离开
	const showTimer = window.setTimeout(show, 900);
	const autoHideTimer = window.setTimeout(hide, 6500);
	root
		.querySelector(".welcome-toast__close")
		?.addEventListener("click", () => {
			window.clearTimeout(showTimer);
			window.clearTimeout(autoHideTimer);
			hide();
		});

	// Swup 导航不重挂载本组件（Layout 长驻），无需清理计时器；
		// 但整页卸载时兜底清理
		window.addEventListener(
			"pagehide",
			() => {
				window.clearTimeout(showTimer);
				window.clearTimeout(autoHideTimer);
			},
			{ once: true },
		);
	})();
</script>