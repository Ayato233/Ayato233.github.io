---
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import { getLqipProps } from "@/utils/lqip-utils";
import { url } from "@/utils/url-utils";

interface Props {
	id: string;
	name: string;
	cover: string;
	description?: string;
	date?: string;
	location?: string;
	tags?: string[];
	photoCount: number;
	encrypted?: boolean;
}

const { id, name, cover, description, date, tags, photoCount, encrypted } =
	Astro.props;

// LQIP 渐变占位
const lqipProps = cover ? getLqipProps(cover, undefined, true) : { style: "" };

// 日期转「2026.01」格式，失败时回退原值
function formatDate(value?: string): string {
	if (!value) return "";
	const m = value.match(/^\d{4}-\d{2}/);
	return m ? m[0].replace("-", ".") : value;
}

const formattedDate = formatDate(date);
---

<div class="album-item onload-animation">
  <div class="album-card group cursor-pointer flex flex-col items-center" data-tags={tags?.join(",") || ""}>
    <!-- 堆叠相纸容器 -->
    <div class="album-stack">
      <!-- 后层 1：hover 大幅右移并加旋转 -->
      <div class="sheet-back-sheet1" aria-hidden="true"></div>

      <!-- 后层 2：hover 反向左移（灰度图） -->
      <div class="sheet-back-sheet2" aria-hidden="true">
        {cover && <img src={cover} alt="" class="w-full h-full object-cover grayscale-[50%]" loading="lazy" decoding="async" />}
      </div>

      <!-- 前层主相纸 -->
      <a
        href={url(`/gallery/${id}/`)}
        class="sheet-main"
        aria-label={name}
      >
        <div class="lqip-placeholder absolute inset-0 pointer-events-none" style={lqipProps.style} aria-hidden="true"></div>
        {cover ? (
          <img
            src={cover}
            alt={name}
            class="album-cover-image"
            loading="lazy"
            decoding="async"
          />
        ) : (
          <div class="w-full h-full bg-gray-200 dark:bg-gray-700 flex items-center justify-center text-gray-400 text-5xl">
            &#x1f4f7;
          </div>
        )}

        {encrypted && (
          <span class="absolute top-2 right-2 z-10 text-sm text-white/90 drop-shadow-md">&#128274;</span>
        )}

        <!-- hover 渐变遮罩 + 信息 -->
        <div class="album-hover-overlay">
          <span class="overlay-photo-count">{photoCount} {i18n(I18nKey.galleryPhotos)}</span>
          {!encrypted && <span class="overlay-open-label">{i18n(I18nKey.galleryClickToOpen)}</span>}
        </div>
      </a>
    </div>

    <!-- 标题 / 日期 / 描述 -->
    <div class="album-info">
      <div class="flex items-center justify-center gap-2 flex-wrap">
        <h3 class="album-title">{name}</h3>
        {formattedDate && <span class="album-date">{formattedDate}</span>}
      </div>
      {description && <p class="album-desc" title={description}>{description}</p>}
    </div>
  </div>
</div>

<style>
  .album-item {
    display: block;
    break-inside: avoid;
  }
  .album-card {
    position: relative;
  }

  /* 堆叠容器：横版 4/3，为后层定位 */
  .album-stack {
    position: relative;
    width: 85%;
    aspect-ratio: 4 / 3;
    margin-bottom: 1.75rem;
  }

  /* 三层相纸通用：白色厚边框（拍立得） */
  .sheet-back-sheet1,
  .sheet-back-sheet2,
  .sheet-main {
    position: absolute;
    inset: 0;
    border-radius: 4px;
    border: 6px solid #fff;
    overflow: hidden;
  }
  :global(.dark) .sheet-back-sheet1,
  :global(.dark) .sheet-back-sheet2,
  :global(.dark) .sheet-main {
    border-color: #e2e8f0;
  }

  /* 后层 1：静态轻微右移 + 旋转，hover 大幅展开 */
  .sheet-back-sheet1 {
    background: #cbd5e1;
    transform: rotate(6deg) translate(1rem, 0.5rem);
    opacity: 0.6;
    transition: transform 0.5s ease, opacity 0.5s ease;
  }
  :global(.dark) .sheet-back-sheet1 {
    background: #334155;
  }
  .album-card:hover .sheet-back-sheet1 {
    transform: rotate(12deg) translate(2rem, 0.5rem);
  }

  /* 后层 2：静态轻微左移 + 反向旋转，hover 反向展开 */
  .sheet-back-sheet2 {
    background: #e2e8f0;
    transform: rotate(-3deg) translate(-0.5rem, -0.25rem);
    opacity: 0.8;
    z-index: 10;
    transition: transform 0.5s ease, opacity 0.5s ease;
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.2);
  }
  :global(.dark) .sheet-back-sheet2 {
    background: #475569;
  }
  .album-card:hover .sheet-back-sheet2 {
    transform: rotate(-6deg) translate(-1.5rem, -0.25rem);
  }

  /* 前层主相纸：hover 上移 + 缩放 */
  .sheet-main {
    display: block;
    background: #fff;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.35);
    z-index: 20;
    transform: translateY(0);
    transition: transform 0.5s ease, box-shadow 0.5s ease;
  }
  :global(.dark) .sheet-main {
    background: #e2e8f0;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.7);
  }
  .album-card:hover .sheet-main {
    transform: translateY(-0.5rem) scale(1.05);
  }

  .album-cover-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s ease;
  }
  .album-card:hover .album-cover-image {
    transform: scale(1.05);
  }

  /* hover 渐变遮罩 */
  .album-hover-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.8), rgba(0, 0, 0, 0.2), transparent);
    opacity: 0;
    transition: opacity 0.5s ease;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 1.25rem;
  }
  .album-card:hover .album-hover-overlay {
    opacity: 1;
  }
  .overlay-photo-count,
  .overlay-open-label {
    transform: translateY(0.5rem);
    transition: transform 0.5s ease;
  }
  .album-card:hover .overlay-photo-count,
  .album-card:hover .overlay-open-label {
    transform: translateY(0);
  }
  .overlay-photo-count {
    font-weight: 700;
    font-size: 1.1rem;
    color: #fff;
    text-shadow: 0 4px 6px rgba(0, 0, 0, 0.5);
  }
  .overlay-open-label {
    margin-top: 0.25rem;
    font-weight: 500;
    font-size: 0.75rem;
    color: var(--primary);
    text-shadow: 0 4px 6px rgba(0, 0, 0, 0.5);
  }

  /* 标题 / 日期 / 描述 */
  .album-info {
    text-align: center;
    width: 100%;
    padding: 0 1rem;
  }
  .album-title {
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.3;
    color: #0f172a;
    transition: color 0.5s ease;
  }
  :global(.dark) .album-title {
    color: #fff;
  }
  .album-card:hover .album-title {
    color: var(--primary);
  }
  .album-date {
    font-size: 0.625rem;
    font-weight: 900;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #64748b;
    background: rgba(255, 255, 255, 0.6);
    backdrop-filter: blur(4px);
    padding: 0.125rem 0.5rem;
    border-radius: 2px;
  }
  :global(.dark) .album-date {
    color: #94a3b8;
    background: rgba(0, 0, 0, 0.3);
  }
  .album-desc {
    font-size: 0.875rem;
    color: #475569;
    margin-top: 0.25rem;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  :global(.dark) .album-desc {
    color: #94a3b8;
  }
</style>
