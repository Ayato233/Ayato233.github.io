---
---

<div class="flex items-center gap-4">
	<img src="/cover.jpg" alt="专辑封面" class="h-16 w-16 rounded-lg object-cover" />
	<div class="min-w-0 flex-1">
		<div class="truncate font-serif text-sm font-bold" id="mp-title">スパーク</div>
		<div class="truncate text-xs opacity-60" id="mp-artist">スーパーカー</div>
		<div class="mt-2 flex items-center gap-2">
			<span class="font-mono text-[10px] opacity-70" id="mp-current">0:00</span>
			<div id="mp-bar" class="relative h-1.5 flex-1 cursor-pointer rounded-full bg-black/25">
				<div id="mp-progress" class="absolute inset-y-0 left-0 rounded-full bg-accent" style="width: 0%"></div>
			</div>
			<span class="font-mono text-[10px] opacity-70" id="mp-total">0:00</span>
		</div>
	</div>
	<div class="flex items-center gap-3 text-xl">
		<button id="mp-prev" aria-label="上一首" class="opacity-80 transition-opacity hover:opacity-100">⏮</button>
		<button id="mp-play" aria-label="播放/暂停" class="flex h-10 w-10 items-center justify-center rounded-full text-white transition-transform hover:scale-110" style="background: var(--color-accent);">▶</button>
		<button id="mp-next" aria-label="下一首" class="opacity-80 transition-opacity hover:opacity-100">⏭</button>
	</div>
</div>

<audio id="mp-audio" preload="metadata"></audio>

<script>
	const tracks = [
		{ title: 'スパーク', artist: 'スーパーカー', src: 'https://www.soundhelix.com/examples/mp3/SoundHelix-Song-1.mp3' },
		{ title: 'Opus', artist: 'Eric Prydz', src: 'https://www.soundhelix.com/examples/mp3/SoundHelix-Song-2.mp3' },
	];
	const audio = document.getElementById('mp-audio');
	const bar = document.getElementById('mp-bar');
	const progress = document.getElementById('mp-progress');
	const currentEl = document.getElementById('mp-current');
	const totalEl = document.getElementById('mp-total');
	const playBtn = document.getElementById('mp-play');
	let i = 0;
	let playing = false;

	function fmt(s) {
		if (isNaN(s)) return '0:00';
		const m = Math.floor(s / 60);
		const r = Math.floor(s % 60);
		return `${m}:${String(r).padStart(2, '0')}`;
	}
	function load(idx) {
		i = idx;
		const t = tracks[i];
		document.getElementById('mp-title').textContent = t.title;
		document.getElementById('mp-artist').textContent = t.artist;
		audio.src = t.src;
		progress.style.width = '0%';
		currentEl.textContent = '0:00';
	}
	function toggle() {
		if (!audio.src) load(0);
		if (audio.paused) {
			audio.play();
			playBtn.textContent = '⏸';
		} else {
			audio.pause();
			playBtn.textContent = '▶';
		}
	}
	playBtn.addEventListener('click', toggle);
	document.getElementById('mp-prev').addEventListener('click', () => load((i - 1 + tracks.length) % tracks.length));
	document.getElementById('mp-next').addEventListener('click', () => load((i + 1) % tracks.length));
	audio.addEventListener('loadedmetadata', () => {
		totalEl.textContent = fmt(audio.duration);
	});
	audio.addEventListener('timeupdate', () => {
		const p = audio.duration ? (audio.currentTime / audio.duration) * 100 : 0;
		progress.style.width = p + '%';
		currentEl.textContent = fmt(audio.currentTime);
	});
	audio.addEventListener('ended', () => load((i + 1) % tracks.length));
	bar.addEventListener('click', (e) => {
		const rect = bar.getBoundingClientRect();
		const ratio = (e.clientX - rect.left) / rect.width;
		if (audio.duration) {
			audio.currentTime = ratio * audio.duration;
		}
	});
</script>