---
import { Icon } from "astro-icon/components";

import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";
import MainGridLayout from "../layouts/MainGridLayout.astro";
---

<MainGridLayout
	title={i18n(I18nKey.notFound)}
	description={i18n(I18nKey.notFoundDescription)}
>
	<!-- 引入右侧边栏布局管理器 -->
	<script>
		import("../scripts/right-sidebar-layout.js");
	</script>
	<div
		class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-96"
	>
		<div
			class="card-base z-10 px-9 py-12 relative w-full flex flex-col items-center justify-center text-center"
		>
			<!-- 小鲸主视觉（内嵌 SVG） -->
			<svg viewBox="0 0 200 200" class="w-40 md:w-52 mb-2" aria-hidden="true">
				<defs>
					<linearGradient id="w404bg" x1="0" y1="0" x2="0.8" y2="1">
						<stop offset="0" stop-color="#1f5f8f"/>
						<stop offset="1" stop-color="#0b2b44"/>
					</linearGradient>
				</defs>
				<rect width="200" height="200" rx="40" fill="url(#w404bg)"/>
				<circle cx="150" cy="52" r="6" fill="#ffd166"/>
				<circle cx="168" cy="40" r="4" fill="#cfeafd" opacity="0.7"/>
				<ellipse cx="95" cy="128" rx="58" ry="36" fill="#8fd0f0"/>
				<ellipse cx="95" cy="136" rx="40" ry="22" fill="#d9f0fd"/>
				<path d="M150 126 q32 -8 44 6 q-16 5 -18 -7 q-8 15 -26 4 z" fill="#6fbadf"/>
				<g stroke="#cfeafd" stroke-width="5" stroke-linecap="round" fill="none">
					<path d="M95 96 q-2 -10 0 -16"/>
					<path d="M86 94 q-8 -6 -5 -14"/>
					<path d="M104 94 q8 -6 5 -14"/>
				</g>
				<circle cx="74" cy="126" r="5.5" fill="#0b2b44"/>
				<circle cx="104" cy="124" r="5" fill="#0b2b44"/>
				<circle cx="105.5" cy="122" r="1.8" fill="#fff"/>
				<circle cx="75.3" cy="124.5" r="1.8" fill="#fff"/>
				<circle cx="60" cy="135" r="4.5" fill="#ff9bb0" opacity="0.75"/>
				<circle cx="114" cy="133" r="4" fill="#ff9bb0" opacity="0.7"/>
				<path d="M82 139 q10 9 20 0" stroke="#0b2b44" stroke-width="3.2" fill="none" stroke-linecap="round"/>
				<text x="98" y="72" text-anchor="middle" font-size="26" font-weight="bold" fill="#fff" opacity="0.9">404</text>
			</svg>

			<!-- 标题 -->
			<h1 class="text-3xl md:text-4xl font-bold mb-4 text-90">
				你游到深海的尽头了
			</h1>

			<!-- 描述 -->
			<p class="text-lg text-75 mb-8 max-w-md leading-relaxed">
				这里没有贝页，只有一只想提醒你回头的小鲸。
				<br />
				也许是链错了方向，也许是海太深。
				<br />
				别担心，回首页换口气就好——咕噜。
			</p>

			<!-- 返回首页按钮 -->
			<a
				href="/"
				class="inline-flex items-center gap-2 px-6 py-3 bg-(--primary) text-white rounded-(--radius-large) hover:opacity-95 transition-colors duration-200 font-medium"
			>
				<Icon name="material-symbols:home" class="text-xl" />
				带我回鲸歌
			</a>

			<!-- 装饰性元素 -->
			<div class="absolute top-4 left-4 opacity-15">
				<Icon name="material-symbols:water" class="text-4xl text-blue-300" />
			</div>
			<div class="absolute bottom-4 right-4 opacity-15">
				<Icon name="material-symbols:bubble" class="text-4xl text-blue-300" />
			</div>
			<div class="absolute bottom-16 left-10 opacity-10">
				<Icon name="material-symbols:star" class="text-4xl text-yellow-200" />
			</div>
		</div>
	</div>
</MainGridLayout>

<style>
	/* 添加一些动画效果 */
	.card-base {
		animation: fadeInUp 0.6s ease-out;
	}

	@keyframes fadeInUp {
		from {
			opacity: 0;
			transform: translateY(30px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	/* 按钮悬停效果 */
	a:hover {
		transform: translateY(-2px);
		box-shadow: 0 4px 12px rgba(var(--primary-rgb), 0.3);
	}
</style>
