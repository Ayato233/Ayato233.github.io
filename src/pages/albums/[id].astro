---
import Layout from '../../layouts/Layout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { formatDate } from '../../utils/date';

export async function getStaticPaths() {
	const albums = await getCollection('albums');
	return albums.map((album) => ({ params: { id: album.id }, props: { album } }));
}

interface Props {
	album: CollectionEntry<'albums'>;
}

const { album } = Astro.props;
---

<Layout title={album.data.title}>
	<div class="mb-10 text-center">
		<a href="/photowall/" class="mb-4 inline-flex items-center gap-1 text-xs opacity-60 transition-opacity hover:opacity-100">← 返回照片墙</a>
		<h1 class="font-serif text-4xl font-black tracking-widest">{album.data.title}</h1>
		<p class="mt-2 font-mono text-sm opacity-60">{album.data.date} · {album.data.photos.length} 张</p>
	</div>

	<div id="album-grid" class="columns-2 gap-4 md:columns-3">
		{
			album.data.photos.map((p) => (
				<figure
					class="group mb-4 break-inside-avoid cursor-zoom-in rounded-xl border-4 border-white shadow-xl transition-transform duration-500 hover:scale-[1.02] dark:border-slate-200"
					data-full={p.src}
				>
					<img src={p.src} alt={p.caption} loading="lazy" class="w-full rounded-lg object-cover" />
					{p.caption && <figcaption class="px-2 py-1.5 text-center text-xs opacity-70">{p.caption}</figcaption>}
				</figure>
			))
		}
	</div>
</Layout>

<script>
	// 点击图片打开 Lightbox
	const grid = document.getElementById('album-grid');
	const figures = grid.querySelectorAll('figure');
	const overlay = document.createElement('div');
	overlay.className = 'fixed inset-0 z-[100] hidden items-center justify-center bg-black/80 p-6';
	overlay.innerHTML = '<img class="max-h-[90vh] max-w-full rounded-lg shadow-2xl" />';
	document.body.appendChild(overlay);
	const overlayImg = overlay.querySelector('img');

	figures.forEach((fig) => {
		fig.addEventListener('click', () => {
			overlayImg.src = fig.dataset.full;
			overlay.classList.remove('hidden');
			overlay.classList.add('flex');
		});
	});
	overlay.addEventListener('click', () => {
		overlay.classList.add('hidden');
		overlay.classList.remove('flex');
	});
</script>