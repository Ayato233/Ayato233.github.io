---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { formatDate } from '../../utils/date';

const posts = (await getCollection('posts')).sort(
	(a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
---

<Layout title="文章">
	<section class="py-10">
		<div class="mb-6 flex items-center justify-between">
			<h1 class="font-serif text-2xl font-black">文章</h1>
			<p class="text-sm opacity-60">共 {posts.length} 篇</p>
		</div>
		<div class="mb-6">
			<div class="glass flex items-center gap-3 px-5 py-3">
				<span class="opacity-60">🔍</span>
				<input
					id="post-search"
					type="search"
					placeholder="搜索文章..."
					class="w-full bg-transparent text-sm outline-none placeholder:opacity-60"
				/>
			</div>
		</div>
		<div id="post-list" class="onload-animation space-y-5" style="animation-delay: 140ms">
			{
				posts.map((p) => (
					<a
						href={`/posts/${p.id}/`}
						data-search={`${p.data.title} ${p.data.summary} ${p.data.tags.join(' ')}`}
						class="glass glass-hover group block p-6"
					>
						<div class="flex items-center gap-3 text-xs opacity-60">
							<span class="rounded-full bg-accent/15 px-2.5 py-0.5 font-semibold text-accent">{p.data.category}</span>
							<time>{formatDate(p.data.date)}</time>
						</div>
						<h2 class="mt-2 font-serif text-lg font-bold transition-colors group-hover:text-accent">{p.data.title}</h2>
						{
							p.data.summary && (
								<p class="mt-1.5 line-clamp-2 text-sm opacity-70">{p.data.summary}</p>
							)
						}
						{
							p.data.tags.length > 0 && (
								<div class="mt-3 flex flex-wrap gap-2">
									{p.data.tags.map((t) => (
										<span class="rounded-full border border-white/15 px-2.5 py-0.5 font-mono text-xs opacity-70">#{t}</span>
									))}
								</div>
							)
						}
					</a>
				))
			}
		</div>
	</section>
</Layout>

<script>
	const input = document.getElementById('post-search');
	const cards = [...document.querySelectorAll('#post-list > a')];
	input.addEventListener('input', () => {
		const q = input.value.trim().toLowerCase();
		cards.forEach((c) => {
			c.style.display = q === '' || c.dataset.search.toLowerCase().includes(q) ? '' : 'none';
		});
	});
	const params = new URLSearchParams(location.search);
	const q = params.get('q');
	if (q) {
		input.value = q;
		input.dispatchEvent(new Event('input'));
	}
</script>