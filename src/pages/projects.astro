---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';

const projects = [
	{
		name: 'Computational Chemistry Tool',
		desc: '该工具本作者使用在 WSL2 平台（Ubuntu22）运行，个人使用请依据自己数据进行修改（这些工具只是整合了一些流程）',
		tags: ['Gromacs', 'RMSF', 'MD'],
		url: '#',
	},
	{
		name: 'MyBlog',
		desc: '一个用 Astro 搭建的个人博客，毛玻璃 + 深色壁纸设计。',
		tags: ['Astro', 'Blog'],
		url: '/',
	},
];
---

<Layout title="项目">
	<PageHeader title="项目矩阵" subtitle="开源项目、科研代码与实验室折腾记录" />
	<div class="onload-animation grid grid-cols-1 gap-5 md:grid-cols-2" style="animation-delay: 140ms">
		{
			projects.map((p) => (
				<a href={p.url} class="glass glass-hover p-6">
					<div class="flex items-center gap-3">
						<span class="text-2xl">🚀</span>
						<h2 class="font-serif text-lg font-bold">{p.name}</h2>
					</div>
					<p class="mt-3 text-sm opacity-70">{p.desc}</p>
					<div class="mt-4 flex flex-wrap gap-2">
						{p.tags.map((t) => (
							<span class="rounded-full bg-accent/15 px-2.5 py-0.5 font-mono text-xs text-accent">{t}</span>
						))}
					</div>
				</a>
			))
		}
	</div>
</Layout>