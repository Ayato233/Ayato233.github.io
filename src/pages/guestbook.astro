---
import { getEntry, render } from "astro:content";
import Card from "@components/atoms/display/Card.svelte";
import Markdown from "@components/content/Markdown.astro";
import CommentSection from "@components/organisms/comment/CommentSection.astro";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { siteConfig } from "@/config";

const guestbookPost = await getEntry("spec", "guestbook");

if (!guestbookPost) {
	throw new Error("Guestbook page content not found");
}

const { Content } = await render(guestbookPost);
---

<MainGridLayout
	title={i18n(I18nKey.guestbook)}
	description={i18n(I18nKey.guestbook)}
	page="guestbook"
	hasComments
>
	<div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
		<Card color="var(--card-bg)" radius="l" class="z-10 px-5 py-6 sm:px-7 relative w-full">
			<Markdown class="mt-2">
				<Content />
			</Markdown>
		</Card>
	</div>

	<CommentSection
		context={{
			key: "guestbook",
			path: "/guestbook/",
			title: i18n(I18nKey.guestbook),
			language: siteConfig.lang,
		}}
		postCommentEnabled={true}
		class="onload-animation"
	/>
</MainGridLayout>