---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import { getCollection, render } from 'astro:content';
import { formatDate } from '../utils/date';

const records = (await getCollection('records')).sort(
	(a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const rendered = await Promise.all(
	records.map(async (r) => ({ ...r, Content: (await render(r)).Content })),
);
---

<Layout title="杂谈">
	<section class="py-12">
	<PageHeader title="云端杂谈" subtitle="“代码、学术、提瓦特与泰拉大陆的碎片记录”" />
		<div class="onload-animation mt-8 space-y-8" style="animation-delay: 140ms">
			{
				rendered.map((r) => (
					<article id={r.id} class="glass p-6">
						<time class="font-mono text-xs text-light-ink-dim dark:text-ink-dim">{formatDate(r.data.date)}</time>
						<h2 class="mt-1 font-serif text-lg font-bold">{r.data.title}</h2>
						<div class="markdown mt-3 text-[0.95rem]">
							<r.Content />
						</div>
					</article>
				))
			}
		</div>
	</section>
</Layout>