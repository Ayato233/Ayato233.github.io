---
import Layout from '../layouts/Layout.astro';
import MusicPlayer from '../components/MusicPlayer.astro';
import { getCollection } from 'astro:content';
import { site } from '../data/site';
import { formatDate } from '../utils/date';

const posts = (await getCollection('posts')).sort(
	(a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const records = (await getCollection('records')).sort(
	(a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const photos = await getCollection('albums');

const latest = posts[0];
const latestRecord = records[0];
---

<Layout>
	<!-- 搜索框 -->
	<div class="onload-animation mx-auto max-w-2xl pb-6" style="animation-delay: 100ms">
		<div class="glass flex items-center gap-3 px-5 py-3">
			<span class="text-ink-dim opacity-60">🔍</span>
			<input
				id="search"
				type="search"
				placeholder="搜索标题、描述或标签..."
				class="w-full bg-transparent text-sm outline-none placeholder:text-ink-dim/60"
			/>
		</div>
	</div>

	<!-- 双卡片头部：profile + 音乐播放器 -->
	<div class="grid grid-cols-1 gap-5 md:grid-cols-12">
		<div class="glass glass-hover onload-animation flex flex-col justify-between p-5 sm:p-6 md:col-span-7" style="animation-delay: 160ms">
			<div class="flex items-center gap-4">
				<div class="flex h-16 w-16 shrink-0 rounded-2xl bg-gradient-to-tr from-indigo-500 to-purple-500 p-1 shadow-lg">
					<img src={site.avatar} alt="avatar" class="h-full w-full rounded-xl object-cover" />
				</div>
				<div class="min-w-0">
					<h1 class="font-serif text-xl font-black">{site.name.split('。')[0]}</h1>
					<p class="text-xs opacity-60">{site.signature}</p>
				</div>
			</div>
			<div class="mt-5 flex items-center justify-between">
				<div class="flex gap-6">
					<div class="flex items-baseline gap-1.5">
						<span class="font-mono text-xl font-bold text-accent">{posts.length}</span>
						<span class="text-xs opacity-60">文章</span>
					</div>
					<div class="flex items-baseline gap-1.5">
						<span class="font-mono text-xl font-bold text-accent">{records.length}</span>
						<span class="text-xs opacity-60">杂谈</span>
					</div>
					<div class="flex items-baseline gap-1.5">
						<span class="font-mono text-xl font-bold text-accent">{photos.length}</span>
						<span class="text-xs opacity-60">相册</span>
					</div>
				</div>
				<div class="flex items-center gap-3">
					{
						site.social.map((s) => (
							<a href={s.url} aria-label={s.name} class="hover:bg-indigo-500 hover:text-white transition-all duration-300 flex h-9 w-9 items-center justify-center rounded-xl bg-white/50 text-slate-700 dark:bg-slate-700/50 dark:text-slate-300">
								<svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
									{s.icon === 'gh' && <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.55 0-.27-.01-1.17-.02-2.12-3.2.7-3.87-1.36-3.87-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.03 1.76 2.69 1.25 3.35.96.1-.75.4-1.25.72-1.54-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.18-3.09-.12-.29-.51-1.46.11-3.05 0 0 .96-.31 3.15 1.18a10.9 10.9 0 0 1 5.74 0c2.19-1.49 3.15-1.18 3.15-1.18.62 1.59.23 2.76.11 3.05.73.81 1.18 1.83 1.18 3.09 0 4.41-2.69 5.38-5.26 5.66.41.36.78 1.05.78 2.12 0 1.54-.01 2.78-.01 3.16 0 .31.21.67.8.55A11.52 11.52 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z" fill="currentColor" />}
									{s.icon === 'tg' && <path d="M21.94 4.2a1.5 1.5 0 0 0-1.63-.26L3.4 11.6c-1.1.46-1.06 2.03.06 2.42l4.2 1.47 1.6 5.02c.34 1.07 1.67 1.32 2.39.45l1.9-2.3 3.93 2.88c.64.47 1.55.16 1.77-.6l2.9-13.03a1.5 1.5 0 0 0-.21-1.7zM8.5 14.6l9.6-6.9c.3-.21.63.15.4.42l-7.1 7.4c-.26.27-.43.63-.47 1.01l-.23 1.9-.4-2.96a1.9 1.9 0 0 1 .2-.87z" fill="currentColor" />}
									{s.icon === 'mail' && <path d="M12 2.5A9.5 9.5 0 1 0 21.5 12 9.5 9.5 0 0 0 12 2.5zm0 2A7.5 7.5 0 0 1 19.5 12c0 2.28-1.02 4.32-2.62 5.68l-1.06-1.62A7.46 7.46 0 0 0 17.5 12 7.5 7.5 0 0 0 10 4.5a7.46 7.46 0 0 0-4.06 1.22L4.32 4.66A9.45 9.45 0 0 1 12 4.5zm0 3a4.5 4.5 0 1 0 4.55 4.5 4.52 4.52 0 0 0-4.55-4.5zM5.5 12a7.4 7.4 0 0 1 .3-2.1l1.94.72A5.5 5.5 0 0 0 7.5 12Z" fill="currentColor" />}
									{s.icon === 'rss' && <path d="M4 3a1 1 0 0 0-1 1v2a13 13 0 0 1 13 13h2a15 15 0 0 0-15-16zM4 8a6 6 0 0 1 6 6h-2a4 4 0 0 0-4-4V8zm0 6a4 4 0 0 1 4 4H4v-4z" fill="currentColor" />}
								</svg>
							</a>
						))
					}
				</div>
			</div>
		</div>
		<div class="glass glass-hover onload-animation p-5 sm:p-6 md:col-span-4" style="animation-delay: 220ms">
			<MusicPlayer />
		</div>
	</div>

	<!-- 作词横幅 -->
	<div class="glass onload-animation mt-6 overflow-hidden px-6 py-2.5 text-center font-mono text-xs text-ink-dim" style="animation-delay: 280ms">
		<span>作词：F-906</span>
	</div>

	<!-- 卡片网格 -->
	<div class="onload-animation mt-6 grid grid-cols-1 gap-5 md:grid-cols-12" style="animation-delay: 340ms">
		<!-- Latest Insight 长卡 -->
		{
			latest && (
				<a href={`/posts/${latest.id}/`} class="glass glass-hover group overflow-hidden md:col-span-4 md:row-span-2">
					<img src="/cover.jpg" alt="" class="h-56 w-full object-cover transition-transform duration-500 group-hover:scale-105" />
					<div class="p-5">
						<div class="flex items-center gap-2 text-[10px] font-semibold uppercase tracking-widest text-accent">
							<span>Latest Insight</span>
							<span class="opacity-60">{formatDate(latest.data.date)}</span>
						</div>
						<h2 class="mt-2 font-serif text-lg font-bold leading-snug group-hover:text-accent transition-colors">
							{latest.data.title}
						</h2>
						<p class="mt-2 line-clamp-3 text-sm opacity-70">{latest.data.summary}</p>
					</div>
				</a>
			)
		}

		<!-- 照片墙卡 -->
		<a href="/photowall/" class="glass glass-hover group overflow-hidden md:col-span-4">
			<img src="/wall.jpg" alt="" class="h-28 w-full object-cover transition-transform duration-500 group-hover:scale-105" />
			<div class="p-4">
				<h3 class="font-serif font-bold group-hover:text-accent transition-colors">泰拉大陆纪行</h3>
				<p class="mt-1 text-xs opacity-70">关于源石、孤星与前文明的视觉记录（测试用相册）</p>
			</div>
		</a>

		<!-- 杂谈卡 -->
		{
			latestRecord && (
				<a href={`/chatter/#${latestRecord.id}`} class="glass glass-hover group overflow-hidden md:col-span-4">
					<img src="/cover.jpg" alt="" class="h-28 w-full object-cover opacity-80 transition-transform duration-500 group-hover:scale-105" />
					<div class="p-4">
						<h3 class="font-serif font-bold group-hover:text-accent transition-colors">{latestRecord.data.title}</h3>
						<p class="mt-1 line-clamp-2 text-xs opacity-70">{latestRecord.body.slice(0, 80)}…</p>
					</div>
				</a>
			)
		}

		<!-- 夜间模式卡 -->
		<div class="glass glass-hover relative overflow-hidden p-5 md:col-span-4">
			<div class="flex items-center gap-3">
				<div class="flex h-10 w-10 items-center justify-center rounded-full text-lg" style="background: color-mix(in srgb, var(--color-accent) 30%, transparent); color: var(--color-accent);">🌙</div>
				<p class="font-serif font-bold">夜间模式</p>
				<span class="ml-auto font-mono text-[10px] opacity-60">流萤飞舞的深空</span>
			</div>
		</div>
	</div>

	<!-- Records 杂谈流 -->
	<section class="onload-animation mt-10" style="animation-delay: 420ms">
		<div class="mb-4 text-left font-serif text-lg font-bold">Records</div>
		<div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
			{
				records.slice(0, 4).map((r) => (
					<a href={`/chatter/#${r.id}`} class="glass glass-hover p-5">
						<time class="font-mono text-xs opacity-60">{formatDate(r.data.date)}</time>
						<h3 class="mt-1 font-serif font-bold transition-colors hover:text-accent">{r.data.title}</h3>
						<p class="mt-1 line-clamp-2 text-xs opacity-70">{r.body.slice(0, 90)}…</p>
					</a>
				))
			}
		</div>
	</section>
</Layout>

<script>
	document.getElementById('search')?.addEventListener('keydown', (e) => {
		if (e.key === 'Enter') {
			const q = e.target.value.trim();
			if (q) window.location.href = `/posts/?q=${encodeURIComponent(q)}`;
		}
	});
</script>