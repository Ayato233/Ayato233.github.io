---
import "../styles/anime.css";

import { AnimeFilters, AnimeSortBar } from "@components/features/anime";
import { PageHeader } from "@components/features/page-header";
import MainGridLayout from "@layouts/MainGridLayout.astro";

import { siteConfig } from "../config";
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";
import {
	getAnimeList,
	getAnimeSourceConfigs,
	getStatusMap,
} from "../utils/anime-data";
import { widgetManager } from "../utils/widget-manager";

if (!siteConfig.featurePages.anime) {
	return Astro.redirect("/404/");
}

const hasRightSidebars =
	widgetManager.getComponentsByPosition("top", "right", "desktop").length > 0 ||
	widgetManager.getComponentsByPosition("sticky", "right", "desktop").length >
		0;

const ANIME_MODE = siteConfig.anime?.mode || "bangumi";
const sourceConfigs = getAnimeSourceConfigs();
const { animeList, currentConfig } = getAnimeList(ANIME_MODE, sourceConfigs);

let emptyDescription = "";
let showEmptyState = false;

if (
	ANIME_MODE === "bilibili" &&
	(!siteConfig.bilibili?.vmid || siteConfig.bilibili.vmid === "")
) {
	showEmptyState = true;
	emptyDescription = i18n(I18nKey.animeConfigBilibili);
} else if (
	ANIME_MODE === "bangumi" &&
	siteConfig.bangumi?.userId === "your-user-id"
) {
	showEmptyState = true;
	emptyDescription = i18n(I18nKey.animeConfigBangumi);
} else if (animeList.length === 0) {
	showEmptyState = true;
	if (
		currentConfig &&
		currentConfig.type === "json" &&
		"emptyDescription" in currentConfig &&
		currentConfig.emptyDescription
	) {
		emptyDescription = currentConfig.emptyDescription;
	} else if (ANIME_MODE === "local") {
		emptyDescription = i18n(I18nKey.animeEmptyLocal);
	} else {
		emptyDescription = "No anime data found.";
	}
}

const statusMap = getStatusMap();
const showExtendedFilters = ANIME_MODE === "bangumi";
const emptyMessage = i18n(I18nKey.animeEmpty);

const sortOptions = [
	{ value: "default", label: i18n(I18nKey.animeFilterAll) },
	{ value: "rating", label: "评分" },
	{ value: "progress", label: "进度" },
	{ value: "year", label: "年份" },
	{ value: "title", label: "名称" },
];

const animeData = {
	list: animeList,
	statusMap,
	labels: {
		year: i18n(I18nKey.animeYear),
		studio: i18n(I18nKey.animeStudio),
	},
	hasRightSidebars,
};
---

<MainGridLayout
	title={i18n(I18nKey.anime)}
	description={i18n(I18nKey.animeSubtitle)}
>
	<div
		class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32"
	>
		<div class="card-base anime-card-base z-10 px-9 py-6 relative w-full">
			<div class="relative w-full mb-8">
				<PageHeader
					title={i18n(I18nKey.animeTitle)}
					subtitle={i18n(I18nKey.animeSubtitle)}
				/>

				<div class="mb-6">
					<AnimeFilters
						filterAllLabel={i18n(I18nKey.animeFilterAll)}
						statusWatchingLabel={i18n(I18nKey.animeStatusWatching)}
						statusPlannedLabel={i18n(I18nKey.animeStatusPlanned)}
						statusCompletedLabel={i18n(
							I18nKey.animeStatusCompleted,
						)}
						statusOnHoldLabel={i18n(I18nKey.animeStatusOnHold)}
						statusDroppedLabel={i18n(I18nKey.animeStatusDropped)}
						showExtendedFilters={showExtendedFilters}
					/>
				</div>

				<div class="mb-4">
					<AnimeSortBar sortByLabel="排序" sortOptions={sortOptions} />
				</div>
			</div>

			<div class="mb-8">
				{
					showEmptyState ? (
						<div class="text-center py-12">
							<div class="text-5xl mb-4">😢</div>
							<h3 class="text-xl font-medium text-black/80 dark:text-white/80 mb-2">
								{emptyMessage}
							</h3>
							<p class="text-black/60 dark:text-white/60">
								{emptyDescription}
							</p>
						</div>
					) : (
						<div
							id="anime-list-container"
							class="anime-grid-container grid gap-4 md:gap-6"
						></div>
					)
				}

				<div
					id="anime-pagination"
					class="flex flex-row gap-3 justify-center mt-8"
				></div>
			</div>
		</div>
	</div>

	<script is:inline define:vars={{ animeData }}>
		window.ANIME_DATA = animeData;
	</script>

	<script is:inline src="/js/anime-pagination.js"></script>
</MainGridLayout>
